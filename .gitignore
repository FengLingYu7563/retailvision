# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# 環境變數（只 commit .env.example）
.env

# 資料集：授權不允許重新散布，只 commit 下載與切分腳本
training/data/raw/
training/data/processed/
training/data/*.tar.gz

# 模型權重與訓練輸出：只 commit models/metrics.json 與圖表
models/*.onnx
models/*.pt
models/*.pth
models/*.joblib
runs/
checkpoints/
*.pt
*.pth

# 執行期檔案
storage/
*.log

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# 模擬相機的監看資料夾（執行期資料）；資料夾本身要存在（docker-compose.yml 的 bind mount）
camera_inbox/*
!camera_inbox/.gitkeep
