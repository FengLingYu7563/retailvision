# 複製成 .env 後修改。.env 已在 .gitignore，不會被 commit。
# 以下全部是範例值，正式環境一定要換掉（尤其是 POSTGRES_PASSWORD、JWT_SECRET、ADMIN_PASSWORD）。

POSTGRES_USER=retail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retailvision

# 本機（不在容器裡）跑 API、測試、CLI 時用；docker compose 會自動改成容器內的位址
DATABASE_URL=postgresql+psycopg://retail:change-me@127.0.0.1:5432/retailvision
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 簽章金鑰：至少 32 字元的隨機字串，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# 容器啟動時自動建立的 admin（帳號已存在就略過，不會覆蓋密碼）。密碼至少 12 字元。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 模擬相機用的帳號（沒設定時用上面的 admin）
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
CAMERA_TYPE=product

# 對外的埠（nginx）
HTTP_PORT=8080

STORAGE_DIR=storage
MODELS_DIR=models
