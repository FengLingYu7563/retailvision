# 複製成 .env 後修改。.env 已在 .gitignore，不會被 commit。
# POSTGRES_PASSWORD、JWT_SECRET、ADMIN_PASSWORD 刻意留空：沒填就無法啟動，避免照抄範例值上線。
# 產生隨機值：python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_USER=retail
POSTGRES_PASSWORD=
POSTGRES_DB=retailvision

# 本機（不在容器裡）跑 API、測試、CLI 時用（<密碼> 換成 POSTGRES_PASSWORD）；
# docker compose 會自動改成容器內的位址
DATABASE_URL=postgresql+psycopg://retail:<密碼>@127.0.0.1:5432/retailvision
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 簽章金鑰：至少 32 字元的隨機字串，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# 容器啟動時自動建立的 admin（帳號已存在就略過，不會覆蓋密碼）。密碼至少 12 字元；留空就不建立。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 模擬相機用的帳號：請另建一般使用者（不要用 admin，沒設定時相機不會啟動），例如
#   docker compose exec api python -m app.cli create-user camera --role user
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
CAMERA_TYPE=product

# 對外的埠（nginx）
HTTP_PORT=8080
# 內部網路：和本機其他網段衝突時再改（api 只信任 NGINX_BACKEND_IP 帶來的 X-Forwarded-For）
# BACKEND_SUBNET=172.30.57.0/24
# NGINX_BACKEND_IP=172.30.57.10

STORAGE_DIR=storage
MODELS_DIR=models
